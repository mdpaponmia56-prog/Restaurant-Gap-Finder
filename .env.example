# Database connection string (SQLite file for local development or PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Google Places API (New) Key
# Leave empty to configure via in-app Settings UI, or set here directly
GOOGLE_MAPS_API_KEY=""

# Application Secret for JWT authentication session
JWT_SECRET="restaurant-gap-finder-jwt-secret-replace-with-secure-key"

# Port & Node Environment
PORT=3000
NODE_ENV="development"
